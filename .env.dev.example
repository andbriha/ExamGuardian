# Copy production example to .env.production and replace EVERY placeholder.
DB_NAME=examguardian
DB_USER=examguardian
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JWT__KEY=REPLACE_WITH_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARS
JWT__ISSUER=ExamGuardianDev
JWT__AUDIENCE=ExamGuardianDevClient
JWT__LIFETIME_MINUTES=60
AiService__ApiKey=REPLACE_WITH_RANDOM_API_KEY
BOOTSTRAP_EXAMINER_LOGIN=examiner
BOOTSTRAP_EXAMINER_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
SEED_DEMO_EXAM=false
ASPNETCORE_ENVIRONMENT=Development
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
DOCS_PORT=4321

# IANA timezone used when displaying the examination schedule.
EXAM_TIME_ZONE=Europe/Chisinau
