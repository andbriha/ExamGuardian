---
interface Props {
	title: string;
	description: string;
	icon: string; // URL or path to SVG
}

const { title, description, icon } = Astro.props;
---
<div class="bg-white p-6 rounded-lg shadow-md border border-slate-100 flex flex-col gap-4">
    <div class="flex items-center gap-3">
        <img src={icon} alt="" class="w-10 h-10 text-sky-600" />
        <h3 class="text-xl font-semibold text-slate-900">{title}</h3>
    </div>
    <p class="text-slate-700 leading-relaxed">{description}</p>
</div>