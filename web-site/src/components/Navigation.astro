---
const pathname = Astro.url?.pathname ?? ''

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/'
  return pathname.startsWith(href)
}

function navClass(href: string): string {
  return isActive(href)
    ? 'text-sky-400 font-semibold border-b-2 border-sky-400 pb-0.5'
    : 'hover:text-sky-300 font-medium text-slate-300 transition-colors'
}
---
<nav class="flex flex-wrap items-center gap-6 px-6 py-3 bg-slate-900 text-white border-b border-slate-700">
  <a href="/" class="flex items-center gap-2 font-bold text-sky-400 text-lg mr-2 shrink-0 hover:text-sky-300 transition-colors">
    <span>🛡️</span>
    <span>ExamGuardian</span>
  </a>

  <div class="flex flex-wrap items-center gap-5 text-sm">
    <a href="/" class={navClass('/')}>Overview</a>
    <a href="/guide" class={navClass('/guide')}>Organizer Guide</a>
    <a href="/dev" class={navClass('/dev')}>Architecture</a>
    <a href="/docs/01-system-context" class={navClass('/docs')}>C4 Docs</a>
  </div>

  <div class="ml-auto flex items-center gap-4 text-sm">
    <a
      href="https://github.com/andbriha/online-proctoring-system"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 text-slate-400 hover:text-white transition-colors"
      title="GitHub Repository"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
      </svg>
      GitHub
    </a>
    <a href="/landing/" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1.5 rounded-md font-semibold transition-colors text-sm">
      Student Portal →
    </a>
  </div>
</nav>
