---
import Layout from '../../layouts/Layout.astro'
import Navigation from '../../components/Navigation.astro'

const workflowSteps = [
  {
    phase: "Phase 1: Deployment & Setup",
    role: "Organizer",
    icon: "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
    details: [
      "Start development with run.ps1, or select production explicitly with --production for the institution deployment.",
      "Development starts the Astro documentation service and independent storage without sample data. Production uses its own configuration, data and HTTPS origin.",
      "Access the web-based monitoring panel.",
      "Create student accounts and enroll a JPEG identity reference for each participant."
    ]
  },
  {
    phase: "Phase 2: Exam Creation",
    role: "Organizer",
    icon: "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
    details: [
      "Create a new exam, assign a specific subject, and link it to a student group.",
      "Build questions and answer options with the test constructor.",
      "Set the start time, duration, attempt limit, passing score and permitted speech/objects."
    ]
  },
  {
    phase: "Phase 3: Student Preparation",
    role: "Student",
    icon: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4",
    details: [
      "Navigate to the web portal and download the native desktop client.",
      "Launch the client and enter the access credentials.",
      "Acknowledge the privacy policy, consenting to microphone and video recording.",
      "Configure the webcam and manually close any prohibited programs."
    ],
    devNote: {
      title: "Client Packaging & Build Instructions",
      content: "Build a verified release with Client/build-release.ps1 and publish that installer to the student portal. Configure the institution server origin on the client login screen. Current behavior and validation limits are documented at /docs/11-current-contract."
    }
  },
  {
    phase: "Phase 4: Execution & Monitoring",
    role: "Automated & Organizer",
    icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z",
    details: [
      "The student selects an assigned exam, completes identity verification and begins a timed attempt.",
      "The AI microservice continuously scans the video and audio streams in the background.",
      "Observations appear in the examiner panel through periodic refresh. Inspect recordings and decide whether to confirm or dismiss each observation."
    ]
  }
];
---
<Layout title="Organizer Guide | ExamGuardian">
    <main class="container mx-auto px-4 py-12 max-w-5xl">
        
        <div class="mb-12 border-b border-slate-200 pb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">System Workflow</h1>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto">A complete step-by-step guide on how to deploy, configure, and execute exams using ExamGuardian.</p>
        </div>
        
        <div class="flex flex-col gap-8">
            {workflowSteps.map((step) => (
                <div class="bg-white border border-slate-200 rounded-2xl p-6 md:p-8 shadow-sm flex flex-col md:flex-row gap-6 items-start">
                    
                    <div class="flex-shrink-0 flex flex-col items-center gap-3 w-32">
                        <div class="w-16 h-16 bg-sky-100 text-sky-600 rounded-2xl flex items-center justify-center shadow-sm border border-sky-200">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={step.icon}></path>
                            </svg>
                        </div>
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400">{step.role}</span>
                    </div>
                    
                    <div class="flex flex-col gap-4 flex-1">
                        <h2 class="text-2xl font-bold text-slate-800">{step.phase}</h2>
                        <ul class="flex flex-col gap-3">
                            {step.details.map(detail => (
                                <li class="flex items-start gap-3 text-slate-600">
                                    <svg class="w-6 h-6 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    <span class="leading-relaxed">{detail}</span>
                                </li>
                            ))}
                        </ul>

                        {step.devNote && (
                            <details class="mt-4 group border border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                                <summary class="cursor-pointer font-semibold text-slate-700 p-4 hover:bg-slate-100 flex items-center justify-between list-none">
                                    {step.devNote.title}
                                    <span class="text-xl group-open:rotate-45 transition-transform duration-200 text-sky-500">+</span>
                                </summary>
                                <div class="p-4 border-t border-slate-200 text-sm text-slate-600 leading-relaxed bg-white">
                                    {step.devNote.content}
                                </div>
                            </details>
                        )}
                    </div>
                </div>
            ))}
        </div>
        
    </main>
</Layout>