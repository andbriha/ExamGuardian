# Prefer scripts/Initialize-Development.ps1 to generate fresh secrets.
DB_NAME=examguardian_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-random-password
ASPNETCORE_ENVIRONMENT=Development
JWT__KEY=replace-with-at-least-48-random-characters
JWT__ISSUER=ExamGuardianServer
JWT__AUDIENCE=ExamGuardianClient
JWT__LIFETIME_MINUTES=1440
AiService__ApiKey=replace-with-an-independent-random-key
BOOTSTRAP_EXAMINER_LOGIN=examiner
BOOTSTRAP_EXAMINER_PASSWORD=replace-with-a-random-password
SEED_DEMO_EXAM=false
NGINX_PORT=80
BACKEND_URL=/api
