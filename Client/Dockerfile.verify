FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build g++ qt6-base-dev qt6-declarative-dev qt6-multimedia-dev \
    qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts \
    qml6-module-qtquick-window qml6-module-qtquick-templates \
    qml6-module-qtqml-workerscript qml6-module-qtmultimedia \
    && rm -rf /var/lib/apt/lists/*
ARG CLIENT_FLAVOR=development
WORKDIR /src
COPY . .
RUN cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DEXAMGUARDIAN_BUILD_TESTS=ON -DEXAMGUARDIAN_FLAVOR=${CLIENT_FLAVOR} \
    && cmake --build /build --parallel 2 \
    && ctest --test-dir /build --output-on-failure \
    && QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software /build/appClient --smoke-test \
    && if [ "$CLIENT_FLAVOR" = production ]; then QT_QPA_PLATFORM=offscreen /build/appClient --verify-production; fi
